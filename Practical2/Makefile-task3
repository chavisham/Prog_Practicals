CC     = gcc
CFLAGS = -I. -MMD -MP
OBJS   = main.o reader.o
TARGET = program

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	echo "link building $@ from $^"
	$(CC) -o $@ $^

%.o: %.c
	echo "compile $< -> $@"
	$(CC) $(CFLAGS) -c -o $@ $<

-include $(OBJS:.o=.d)

clean:
	echo "clean removing objects, .d files and the executable"
	rm -f $(OBJS) $(OBJS:.o=.d) $(TARGET)